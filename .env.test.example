# Copia este archivo como .env.test y completa con tus cuentas de prueba.
# NUNCA commitees .env.test con credenciales reales.

# URL del frontend donde corren los tests E2E
TEST_BASE_URL=http://localhost:5173

# Cuenta con rol ADMIN y plan Gratis (para probar límites de plan)
TEST_ADMIN_EMAIL=admin@tuempresa.com
TEST_ADMIN_PASSWORD=tu-password-aqui

# Cuenta con rol CAJERO de la misma empresa
TEST_CAJERO_EMAIL=cajero@tuempresa.com
TEST_CAJERO_PASSWORD=tu-password-aqui

# Cuenta de OTRA empresa (para probar aislamiento multi-tenancy)
TEST_OTRO_EMAIL=otro@otraempresa.com
TEST_OTRO_PASSWORD=tu-password-aqui

# Cuenta con rol BODEGA de la misma empresa
TEST_BODEGA_EMAIL=bodega@tuempresa.com
TEST_BODEGA_PASSWORD=tu-password-aqui

# Cuenta con rol SUPERVISOR de la misma empresa
TEST_SUPERVISOR_EMAIL=supervisor@tuempresa.com
TEST_SUPERVISOR_PASSWORD=tu-password-aqui

# Cuenta registrada pero con email sin verificar (para test 1.8)
TEST_UNVERIFIED_EMAIL=sinverificar@tuempresa.com
TEST_UNVERIFIED_PASSWORD=tu-password-aqui
